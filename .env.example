# Copy to .env and fill in — or let the application do it: pasting a key into
# the model dialog's "api key" field writes this file. The engine loads it as its
# project env layer (inherited environment first, then this file), so a value
# exported in the shell wins. This is the ONLY credential the harness reads —
# never use DEEPSEEK_API_KEY: the shipped DeepSeek routes are mounted off, and
# the provider this application mounts reads AI_API_KEY exclusively.
AI_API_KEY=

# Optional: a deployment fallback route, for a workspace nobody has configured
# yet. Both variables or neither: the composition (see
# App/dsh-plugins/hackathon-harness-preset/cordis.yml) reads the pair and mounts
# nothing when either is unset. Adding a model in the application is the normal
# way a route appears; these are for a headless deployment.
# AI_HARNESS_FALLBACK_MODEL=deepseek-chat
# AI_HARNESS_FALLBACK_BASE_URL=https://api.deepseek.com/v1

# The deployed route is data, not config: .harness/models.json lists every
# provider and model, and its `active` entry is the route a session starts on.
# The budget caps and the committee bench are declared in the bundle's cordis.yml
# and overridden from a profile patch — never from here.
